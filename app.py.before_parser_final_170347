# =========================================================

def analyze_custom_request(
    request_text,
    override_balance,
    override_minimum,
    override_currency,
    override_date,
    override_income,
    override_expense,
):
    try:
        parsed = classify_facts(
            extract_agent_facts(
                request_text
            )
        )

        # -------------------------------------------------
        # Structured fields are optional overrides.
        # They are not mandatory duplicate inputs.
        # -------------------------------------------------

        if (
            override_balance is not None
            and as_text(
                override_balance
            ).strip()
        ):
            parsed["balance"] = parse_decimal(
                override_balance,
                "Current account balance",
            )

        if (
            override_minimum is not None
            and as_text(
                override_minimum
            ).strip()
        ):
            parsed["minimum_balance"] = parse_decimal(
                override_minimum,
                "Minimum balance to keep",
            )

        if as_text(
            override_currency
        ).strip():
            parsed["currency"] = (
                as_text(
                    override_currency
                )
                .strip()
                .upper()
            )

        if as_text(
            override_date
        ).strip():
            parsed["desired_date"] = (
                parse_iso_date(
                    override_date
                )
            )

        future_income = None
        future_expense = None

        if as_text(
            override_income
        ).strip():
            future_income = parse_decimal(
                override_income,
                "Known future income",
            )

        if as_text(
            override_expense
        ).strip():
            future_expense = parse_decimal(
                override_expense,
                "Known future expense",
            )

        # -------------------------------------------------
        # Missing-information agent behavior.
        # -------------------------------------------------

        missing = []

        if parsed["amount"] is None:
            missing.append(
                "the amount you want to pay"
            )

        if parsed["balance"] is None:
            missing.append(
                "your current account balance"
            )

        if parsed["minimum_balance"] is None:
            missing.append(
                "the minimum balance you want protected"
            )

        if parsed["currency"] is None:
            missing.append(
                "your account currency"
            )

        if missing:
            bullet_list = "\n".join(
                f"- {item}"
                for item in missing
            )

            detected = []

            if parsed["amount"] is not None:
                detected.append(
                    f"Requested amount: "
                    f"{money(parsed['currency'] or '?', parsed['amount'])}"
                )

            if parsed["balance"] is not None:
                detected.append(
                    f"Current balance: "
                    f"{money(parsed['currency'] or '?', parsed['balance'])}"
                )

            if parsed["minimum_balance"] is not None:
                detected.append(
                    f"Minimum protected: "
                    f"{money(parsed['currency'] or '?', parsed['minimum_balance'])}"
                )

            detected_text = (
                "\n".join(
                    f"- {x}"
                    for x in detected
                )
                if detected
                else "- Nothing confidently detected yet."
            )

            source_label = (
                "Gemini"
                if parsed["source"] == "gemini"
                else "local fallback"
            )

            return (
                "NEEDS_INPUT",
                detected_text,
                (
                    f"## 🟠 I NEED MORE INFORMATION\n\n"
                    f"The {source_label} request parser "
                    f"understood the following:\n\n"
                    f"{detected_text}\n\n"
                    f"Before I calculate affordability, "
                    f"I need:\n\n"
                    f"{bullet_list}\n\n"
                    f"Put the missing information into the "
                    f"same request or use the optional "
                    f"advanced fields below."
                ),
                "",
                "",
                "",
                "",
                (
                    "### Agent guardrail\n\n"
                    "The system never invents financial "
                    "information that the user did not provide."
                ),
            )

        balance = parsed["balance"]
        minimum_balance = parsed[
            "minimum_balance"
        ]
        currency = parsed["currency"]
        amount = parsed["amount"]

        if minimum_balance > balance:
            raise ValueError(
                "Minimum protected balance cannot be "
                "greater than the current account balance."
            )

        today = date.today()

        desired_date = (
            parsed["desired_date"]
            or today
        )

        horizon_end = (
            today + timedelta(days=90)
        )

        if not (
            today
            <= desired_date
            <= horizon_end
        ):
            raise ValueError(
                "Requested completion date must be "
                f"between {today} and {horizon_end}."
            )

        # -------------------------------------------------
        # Build temporary custom profile.
        # -------------------------------------------------

        profile = make_custom_profile(
            balance=balance,
            minimum_balance=minimum_balance,
            currency=currency,
        )

        events = make_custom_events(
            user_id="custom_user",
            start_date=today,
            currency=currency,
            future_income=future_income,
            future_expense=future_expense,
        )

        request = FinancialRequest(
            request_id="custom_request",
            user_id="custom_user",
            request_date=today,
            request_type=(
                parsed["request_type"]
                or "other"
            ),
            requested_amount=amount,
            desired_completion_date=desired_date,
            allows_partial_payment=(
                parsed["installment_count"]
                is not None
            ),
            request_text=request_text.strip(),
        )

        payment_options = build_payment_options(
            request_id=request.request_id,
            amount=amount,
            start_date=today,
            desired_date=desired_date,
            installment_count=(
                parsed["installment_count"]
            ),
            payment_frequency=(
                parsed["payment_frequency"]
            ),
            financing_fee=(
                parsed["financing_fee"]
            ),
        )

        # -------------------------------------------------
        # V4 remains the authority.
        # -------------------------------------------------

        decision = decide_v4(
            events=events,
            profile=profile,
            request=request,
            payment_options=payment_options,
            exchange_rates=rates,
        )

        status = as_text(
            enum_or_str(
                decision.affordability_status
            )
        )

        method = as_text(
            enum_or_str(
                decision.recommended_payment_method
            )
        )

        plan = "; ".join(
            f"{p.date.isoformat()}: {p.amount}"
            for p in decision.payment_plan
        ) or "None"

        earliest = (
            decision.earliest_date_for_full_payment.isoformat()
            if decision.earliest_date_for_full_payment
            else "N/A"
        )

        changes = "; ".join(
            as_text(change)
            for change in decision.spending_changes_needed
            if as_text(change)
        ) or "None"

        explanation = as_text(
            decision.decision_explanation
        ).replace(
            "None of the available payment options keeps "
            "the required minimum balance protected across "
            "the forecast.",
            "The requested amount cannot be paid while "
            "keeping the required minimum balance protected "
            "across the forecast.",
        )

        source_label = (
            "🧠 Gemini agent"
            if parsed["source"] == "gemini"
            else "🛡️ Gemini fallback"
        )

        detected = (
            f"- Requested amount: "
            f"{money(currency, amount)}\n"
            f"- Current balance: "
            f"{money(currency, balance)}\n"
            f"- Minimum protected: "
            f"{money(currency, minimum_balance)}\n"
            f"- Currency: `{currency}`\n"
            f"- Completion date: `{desired_date}`\n"
            f"- Request type: `{parsed['request_type']}`"
        )

        if parsed["installment_count"]:
            detected += (
                f"\n- Proposed payments: "
                f"{parsed['installment_count']}"
            )

        if parsed["payment_frequency"]:
            detected += (
                f"\n- Frequency: "
                f"{parsed['payment_frequency']}"
            )

        decision_text = (
            f"{status_headline(status)}\n\n"

            f"{source_label}\n\n"

            f"**Requested:** "
            f"{money(currency, amount)}\n\n"

            f"**Safe to pay today:** "
            f"{money(currency, decision.amount_safe_to_pay)}\n\n"

            f"**Current balance:** "
            f"{money(currency, balance)}\n\n"

            f"**Minimum protected:** "
            f"{money(currency, minimum_balance)}\n\n"

            f"**Completion:** `{desired_date}`\n\n"

            f"**Recommended method:** "
            f"`{method}`\n\n"

            f"**Payment plan:** "
            f"{plan}\n\n"

            f"**Earliest full payment:** "
            f"`{earliest}`\n\n"

            f"**Spending changes:** "
            f"{changes}\n\n"

            f"**Explanation:** "
            f"{explanation}"
        )

        guardrails = (
            "### Agent guardrails\n\n"
            f"- `{source_label}` handles request "
            "understanding only.\n"
            "- Missing financial facts are requested "
            "instead of invented.\n"
            "- Current balance and purchase amount are "
            "separate concepts.\n"
            "- Minimum protected balance is enforced.\n"
            "- Currency must be consistent.\n"
            "- Forecast is limited to 90 days.\n"
            "- Installment plans are only created when "
            "the user explicitly states a payment count.\n"
            "- Financing fees are never invented.\n"
            "- V4 is the final financial authority."
        )

        return (
            status,
            detected,
            decision_text,
            money(
                currency,
                amount,
            ),
            money(
                currency,
                decision.amount_safe_to_pay,
            ),
            method,
            plan,
            earliest,
            changes,
            guardrails,
        )

    except Exception as exc:
        return (
            "INPUT_ERROR",
            "",
            (
                "### Validation error\n\n"
                f"**{type(exc).__name__}:** "
                f"{exc}"
            ),
            "",
            "",
            "",
            "",
            "",
            "",
            "",
        )


