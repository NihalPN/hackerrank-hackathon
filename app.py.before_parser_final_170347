"""


CURRENCY_RE = re.compile(
    r"\b("
    r"IDR|INR|ZAR|USD|EUR|GBP|AUD|CAD"
    r")\s*"
    r"([0-9][0-9,]*(?:\.[0-9]+)?)",
    re.IGNORECASE,
)

NUMBER_RE = re.compile(
    r"\b([0-9][0-9,]*(?:\.[0-9]+)?)\b"
)


def _money_matches(text: str):
    pattern = re.compile(
        r"\b("
        r"IDR|INR|ZAR|USD|EUR|GBP|AUD|CAD"
        r")\s*"
        r"([0-9][0-9,]*(?:\.[0-9]+)?)",
        re.IGNORECASE,
    )

    results = []

    for match in pattern.finditer(text or ""):
        try:
            results.append(
                {
                    "currency": match.group(1).upper(),
                    "amount": Decimal(
                        match.group(2).replace(",", "")
                    ),
                    "start": match.start(),
                    "end": match.end(),
                    "text": match.group(0),
                }
            )
        except InvalidOperation:
            continue

    return results


def _context(text: str, start: int, end: int, window: int = 90):
    left = max(0, start - window)
    right = min(len(text), end + window)
    return text[left:right].lower()


def _classify_money_roles(text: str):
    """
    Assign semantic roles to monetary mentions.

    Priority:
    1. Explicit account balance
    2. Explicit minimum/reserve
    3. Explicit income
    4. Explicit expense
    5. Purchase/request amount
    """

    matches = _money_matches(text)

    balance = None
    minimum_balance = None
    requested_amount = None
    currency = None
    income = None
    expense = None

    for item in matches:
        amount = item.get("amount", item.get("value"))
        item_currency = item["currency"]
        context = _context(
            text,
            item["start"],
            item["end"],
        )

        if currency is None:
            currency = item_currency

        # -----------------------------
        # Account balance
        # -----------------------------
        if (
            re.search(
                r"\b("
                r"i have|"
                r"i've got|"
                r"my balance is|"
                r"account balance|"
                r"current balance|"
                r"cash balance|"
                r"available balance"
                r")\b",
                context,
            )
            and balance is None
        ):
            balance = amount
            continue

        # -----------------------------
        # Minimum protected balance
        # -----------------------------
        if (
            re.search(
                r"\b("
                r"keep|"
                r"leave|"
                r"reserve|"
                r"untouched|"
                r"minimum|"
                r"at least"
                r")\b",
                context,
            )
            and re.search(
                r"\b("
                r"keep|"
                r"leave|"
                r"reserve|"
                r"untouched|"
                r"minimum|"
                r"protected"
                r")\b",
                context,
            )
        ):
            if minimum_balance is None:
                minimum_balance = amount
                continue

        # -----------------------------
        # Future income
        # -----------------------------
        if re.search(
            r"\b("
            r"salary|"
            r"income|"
            r"receive|"
            r"get paid|"
            r"paycheck|"
            r"bonus"
            r")\b",
            context,
        ):
            if income is None:
                income = amount
                continue

        # -----------------------------
        # Future expense
        # -----------------------------
        if re.search(
            r"\b("
            r"rent|"
            r"bill|"
            r"expense|"
            r"due|"
            r"owe|"
            r"payment due"
            r")\b",
            context,
        ):
            if expense is None:
                expense = amount
                continue

    # -----------------------------
    # Requested purchase amount
    #
    # Look for explicit purchase
    # language.
    # -----------------------------
    for item in matches:
        context = _context(
            text,
            item["start"],
            item["end"],
            window=120,
        )

        if re.search(
            r"\b("
            r"buy|"
            r"purchase|"
            r"considering|"
            r"looking at|"
            r"costs?|"
            r"price|"
            r"laptop|"
            r"phone|"
            r"computer|"
            r"car|"
            r"item"
            r")\b",
            context,
        ):
            requested_amount = item.get("amount", item.get("value"))
            currency = item["currency"]
            break

    # Last-resort behavior:
    #
    # If there is exactly one money value and no
    # balance/request distinction, treat it as the request.
    if (
        requested_amount is None
        and len(matches) == 1
    ):
        requested_amount = matches[0]["amount"]
        currency = matches[0]["currency"]

    return {
        "balance": balance,
        "minimum_balance": minimum_balance,
        "amount": requested_amount,
        "currency": currency,
        "income": income,
        "expense": expense,
        "money_mentions": matches,
    }



def local_parse_request(text):
    """Deterministic fallback parser for custom natural-language requests."""
    from decimal import Decimal, InvalidOperation
    import re

    text = (text or "").strip()

    result = {
        "facts": [],
        "parser": "local",
        "missing": [],
    }

    if not text:
        result["missing"] = [
            "current account balance",
            "minimum protected balance",
            "requested purchase amount",
            "currency",
        ]
        return result

    # Amounts such as:
    # ZAR 30,000
    # INR 100000
    # $2,500
    # EUR 496.10
    money_re = re.compile(
        r"(?P<currency>\$|€|£|₹|[A-Za-z]{3})?\s*"
        r"(?P<amount>\d+(?:,\d{3})*(?:\.\d+)?)",
        re.IGNORECASE,
    )

    symbol_currency = {
        "$": "USD",
        "€": "EUR",
        "£": "GBP",
        "₹": "INR",
    }

    mentions = []

    for m in money_re.finditer(text):
        raw_amount = m.group("amount").replace(",", "")
        try:
            amount = Decimal(raw_amount)
        except (InvalidOperation, ValueError):
            continue

        raw_currency = m.group("currency")
        currency = None

        if raw_currency:
            currency = symbol_currency.get(
                raw_currency,
                raw_currency.upper()
            )

        left = max(0, m.start() - 100)
        right = min(len(text), m.end() + 140)

        mentions.append({
            "amount": amount,
            "currency": currency,
            "context": text[left:right],
            "start": m.start(),
            "end": m.end(),
        })

    def has(context, *patterns):
        return any(
            re.search(p, context, re.IGNORECASE)
            for p in patterns
        )

    balance = None
    minimum = None
    requested = None
    income = None
    expense = None
    fee = None

    # Classify by language, NEVER by amount size.
    for item in mentions:
        c = item["context"]

        if has(
            c,
            r"\bkeep\b",
            r"\bleave\b",
            r"\breserve\b",
            r"\bminimum\b",
            r"\bprotected\b",
            r"\buntouched\b",
            r"\bat least\b",
            r"\bretain\b",
            r"\bdo not spend\b",
            r"\bdon't spend\b",
        ):
            if minimum is None:
                minimum = item
            continue

        if has(
            c,
            r"\bfee\b",
            r"\bfees\b",
            r"\binterest\b",
            r"\bcharge\b",
            r"\bfinancing cost\b",
        ):
            if fee is None:
                fee = item
            continue

        if has(
            c,
            r"\bsalary\b",
            r"\bincome\b",
            r"\bpaycheck\b",
            r"\bbonus\b",
            r"\bget paid\b",
            r"\bgetting paid\b",
            r"\breceive\b",
        ):
            if income is None:
                income = item
            continue

        if has(
            c,
            r"\brent\b",
            r"\bbill\b",
            r"\bexpense\b",
            r"\bowe\b",
            r"\bdue\b",
            r"\bpayment due\b",
            r"\bdebt\b",
        ):
            if expense is None:
                expense = item
            continue

        if has(
            c,
            r"\baccount balance\b",
            r"\bcurrent balance\b",
            r"\bavailable balance\b",
            r"\bcash balance\b",
            r"\bmy balance\b",
            r"\bin my account\b",
            r"\bin the account\b",
            r"\bI have\b",
            r"\bI've got\b",
        ):
            if balance is None:
                balance = item
            continue

        if has(
            c,
            r"\bconsidering\b",
            r"\bbuy\b",
            r"\bpurchase\b",
            r"\bcosts?\b",
            r"\bprice\b",
            r"\blooking at\b",
            r"\blooking to buy\b",
            r"\bwant\b",
            r"\blaptop\b",
            r"\bphone\b",
            r"\bcomputer\b",
            r"\bcar\b",
            r"\bbooking\b",
        ):
            if requested is None:
                requested = item
            continue

    # Very important for phrases such as:
    # "I have ZAR 30,000 ... ZAR 5,000 untouched ...
    #  considering a ZAR 33,114 laptop."
    if requested is None:
        candidates = [
            x for x in mentions
            if x is not balance
            and x is not minimum
            and x is not income
            and x is not expense
            and x is not fee
        ]

        if len(candidates) == 1:
            requested = candidates[0]

    def add(fact_type, item, confidence=0.96):
        if item is None:
            return

        result["facts"].append({
            "fact_type": fact_type,
            "value": str(item.get("amount", item.get("value"))),
            "currency": item["currency"],
            "confidence": confidence,
            "source_text": item["context"].strip(),
        })

    add("balance", balance)
    add("minimum_balance", minimum)
    add("amount", requested)
    add("income", income)
    add("expense", expense)
    add("financing_fee", fee)

    # Currency from explicit monetary mention.
    currency = next(
        (x["currency"] for x in mentions if x["currency"]),
        None,
    )

    if currency:
        result["facts"].append({
            "fact_type": "currency",
            "value": currency,
            "currency": currency,
            "confidence": 0.99,
            "source_text": text,
        })

    # Explicit installment plan only.
    installment_patterns = [
        r"\b(\d+)\s+monthly\s+installments?\b",
        r"\b(\d+)\s+month(?:ly)?\s+payments?\b",
        r"\b(\d+)\s+installments?\b",
        r"\bpay\s+(?:it|this|that)\s+in\s+(\d+)\s+payments?\b",
    ]

    installment_count = None

    for pattern in installment_patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            installment_count = int(match.group(1))
            break

    if installment_count is not None:
        result["facts"].append({
            "fact_type": "installment_count",
            "value": str(installment_count),
            "currency": None,
            "confidence": 0.99,
            "source_text": text,
        })

        result["facts"].append({
            "fact_type": "payment_frequency",
            "value": "monthly" if re.search(
                r"\bmonthly\b|\bmonth\b",
                text,
                re.IGNORECASE,
            ) else "unknown",
            "currency": None,
            "confidence": 0.99,
            "source_text": text,
        })

    # Request type.
    low = text.lower()

    if any(x in low for x in [
        "laptop", "phone", "computer", "car",
        "buy", "purchase", "considering",
    ]):
        request_type = "purchase"
    elif any(x in low for x in ["trip", "travel", "flight", "hotel"]):
        request_type = "travel"
    elif any(x in low for x in ["course", "tuition", "education"]):
        request_type = "education"
    elif any(x in low for x in ["rent", "house", "deposit"]):
        request_type = "housing"
    else:
        request_type = "purchase"

    result["facts"].append({
        "fact_type": "request_type",
        "value": request_type,
        "currency": None,
        "confidence": 0.90,
        "source_text": text,
    })

    if requested is None:
        result["missing"].append("requested purchase amount")

    if balance is None:
        result["missing"].append("current account balance")

    if minimum is None:
        result["missing"].append("minimum protected balance")

    if currency is None:
        result["missing"].append("currency")

    return result



def extract_agent_facts(text: str) -> dict:
    text = as_text(text).strip()

    if not text:
        raise ValueError(
            "Tell the agent what you want to pay "
            "and, when possible, your financial situation."
        )

    try:
        result = GEMINI.extract(
            prompt=(
                AGENT_PROMPT
                + "\n\nUSER INPUT\n"
                + text
            ),
            images=(),
        )

        facts = list(
            getattr(
                result,
                "facts",
                (),
            )
        )

        if facts:
            return {
                "facts": facts,
                "source": "gemini",
            }

    except Exception as exc:
        fallback = local_parse_request(text)
        fallback["fallback_reason"] = (
            f"Gemini unavailable: "
            f"{type(exc).__name__}"
        )
        return fallback

    fallback = local_parse_request(text)
    fallback["fallback_reason"] = (
        "Gemini returned no usable facts."
    )
    return fallback



def classify_facts(facts):
    """Normalize Gemini/local facts into the custom-agent state."""
    result = {
        "balance": None,
        "minimum_balance": None,
        "requested_amount": None,
        "currency": None,
        "completion_date": None,
        "request_type": "purchase",
        "income": [],
        "expense": [],
        "installment_count": None,
        "payment_frequency": None,
        "financing_fee": None,
    }

    for fact in facts or []:
        if not isinstance(fact, dict):
            continue

        kind = str(fact.get("fact_type", "")).strip().lower()
        value = fact.get("value")

        if value in (None, "", "null"):
            continue

        if kind in {
            "balance",
            "current_balance",
            "account_balance",
        }:
            result["balance"] = value

        elif kind in {
            "minimum_balance",
            "minimum_protected",
            "minimum_protected_balance",
            "protected_balance",
        }:
            result["minimum_balance"] = value

        elif kind in {
            "amount",
            "requested_amount",
            "purchase_amount",
            "request_amount",
        }:
            result["requested_amount"] = value

        elif kind == "currency":
            result["currency"] = str(value).upper()

        elif kind in {
            "date",
            "completion_date",
            "desired_completion_date",
        }:
            result["completion_date"] = str(value)

        elif kind == "request_type":
            result["request_type"] = str(value)

        elif kind == "income":
            result["income"].append(value)

        elif kind == "expense":
            result["expense"].append(value)

        elif kind in {
            "installment_count",
            "number_of_payments",
        }:
            try:
                result["installment_count"] = int(value)
            except (TypeError, ValueError):
                pass

        elif kind in {
            "payment_frequency",
            "frequency",
        }:
            result["payment_frequency"] = str(value).lower()

        elif kind in {
            "financing_fee",
            "fee",
        }:
            result["financing_fee"] = value

    return result


