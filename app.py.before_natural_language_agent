def custom_window_text(
    balance,
    minimum_balance,
    currency,
):
    try:
        b = parse_decimal(balance)
        m = parse_decimal(minimum_balance)
    except Exception:
        return (
            "Enter a valid account balance and "
            "minimum protected balance."
        )

    if m > b:
        return (
            "⚠️ Minimum protected balance cannot be "
            "greater than the current account balance."
        )

    today = date.today()
    horizon = today + timedelta(days=90)

    return (
        f"**Current balance:** "
        f"{format_money(currency, b)}  \n"
        f"**Minimum protected:** "
        f"{format_money(currency, m)}  \n"
        f"**Forecast:** "
        f"`{today}` → `{horizon}`"
    )


def custom_analyze(
    balance,
    minimum_balance,
    currency,
    request_text,
    desired_date,
    future_income,
    future_expenses,
):
    try:
        currency = safe_str(
            currency
        ).strip().upper()

        if not currency:
            raise ValueError(
                "Enter your account currency."
            )

        balance = parse_decimal(
            balance
        )

        minimum_balance = parse_decimal(
            minimum_balance
        )

        if minimum_balance > balance:
            raise ValueError(
                "Minimum protected balance cannot be "
                "greater than current balance."
            )

        # ---------------------------------------------
        # Gemini extracts the request.
        # ---------------------------------------------

        parsed = parse_custom_request(
            request_text
        )

        amount = parsed["amount"]

        request_currency = (
            parsed.get("currency")
            or currency
        )

        if request_currency != currency:
            raise ValueError(
                f"The request uses {request_currency}, "
                f"but the account is denominated in "
                f"{currency}. "
                f"Please use the same currency."
            )

        # ---------------------------------------------
        # Date
        # ---------------------------------------------

        today = date.today()

        if desired_date.strip():
            completion_date = parse_date(
                desired_date
            )
        elif parsed.get("desired_date"):
            completion_date = parse_date(
                parsed["desired_date"]
            )
        else:
            completion_date = today

        horizon_end = (
            today + timedelta(days=90)
        )

        if not (
            today
            <= completion_date
            <= horizon_end
        ):
            raise ValueError(
                "Completion date must be between "
                f"{today} and {horizon_end}."
            )

        # ---------------------------------------------
        # Optional future state
        # ---------------------------------------------

        income = Decimal("0")
        expenses = Decimal("0")

        if safe_str(
            future_income
        ).strip():
            income = parse_decimal(
                future_income
            )

        if safe_str(
            future_expenses
        ).strip():
            expenses = parse_decimal(
                future_expenses
            )

        profile = build_custom_profile(
            balance=balance,
            minimum_balance=minimum_balance,
            currency=currency,
        )

        events = build_custom_events(
            user_id="custom_user",
            start_date=today,
            future_income=income,
            future_expenses=expenses,
            currency=currency,
        )

        request = FinancialRequest(
            request_id="custom_request",
            user_id="custom_user",
            request_date=today,
            request_type=parsed.get(
                "request_type",
                "other",
            ),
            requested_amount=amount,
            desired_completion_date=(
                completion_date
            ),
            allows_partial_payment=bool(
                parsed.get(
                    "allows_partial_payment",
                    False,
                )
            ),
            request_text=request_text.strip(),
        )

        # ---------------------------------------------
        # Deterministic financial authority
        # ---------------------------------------------

        decision = decide_v4(
            events=events,
            profile=profile,
            request=request,
            payment_options=[],
            exchange_rates=rates,
        )

        status = safe_str(
            enum_or_str(
                decision.affordability_status
            )
        )

        method = safe_str(
            enum_or_str(
                decision.recommended_payment_method
            )
        )

        plan = "; ".join(
            f"{p.date.isoformat()}: {p.amount}"
            for p in decision.payment_plan
        ) or "None"

        earliest = (
            decision.earliest_date_for_full_payment.isoformat()
            if decision.earliest_date_for_full_payment
            else "N/A"
        )

        changes = "; ".join(
            safe_str(x)
            for x in decision.spending_changes_needed
            if safe_str(x)
        ) or "None"

        decision_explanation = (
            decision.decision_explanation
            .replace(
                "None of the available payment options keeps "
                "the required minimum balance protected across "
                "the forecast.",
                "The requested amount cannot be paid while "
                "keeping the required minimum balance protected "
                "across the forecast.",
            )
        )

        source = parsed.get(
            "source",
            "unknown",
        )

        # ---------------------------------------------
        # Agent result
        # ---------------------------------------------

        if source == "gemini":
            agent_note = (
                "🧠 **Gemini agent:** "
                "request understood successfully."
            )
        else:
            agent_note = (
                "🛡️ **Gemini fallback:** "
                "Gemini was unavailable, so the validated "
                "local parser was used."
            )

        decision_text = (
            f"{status_headline(status)}\n\n"

            f"{agent_note}\n\n"

            f"**Requested amount:** "
            f"{format_money(currency, amount)}\n\n"

            f"**Current account balance:** "
            f"{format_money(currency, balance)}\n\n"

            f"**Minimum protected balance:** "
            f"{format_money(currency, minimum_balance)}\n\n"

            f"**Requested completion:** "
            f"`{completion_date}`\n\n"

            f"**Safe amount:** "
            f"{format_money(currency, decision.amount_safe_to_pay)}\n\n"

            f"**Status:** `{status}`\n\n"

            f"**Recommended method:** `{method}`\n\n"

            f"**Payment plan:** {plan}\n\n"

            f"**Earliest full payment:** `{earliest}`\n\n"

            f"**Spending changes:** {changes}\n\n"

            f"**Explanation:** "
            f"{decision_explanation}"
        )

        guardrails = (
            "### Guardrails\n\n"
            "- User-entered balance is isolated to this "
            "custom simulation.\n"
            "- Minimum protected balance is enforced.\n"
            "- Requested amount is extracted from the request "
            "rather than entered twice.\n"
            "- Currency must match the account currency.\n"
            "- Completion date is constrained to 90 days.\n"
            "- Gemini can interpret the request but cannot "
            "override the financial engine.\n"
            "- Financial calculations use Decimal.\n"
            "- Gemini failure triggers deterministic fallback."
        )

        return (
            status,
            format_money(
                currency,
                amount,
            ),
            format_money(
                currency,
                decision.amount_safe_to_pay,
            ),
            method,
            plan,
            earliest,
            changes,
            decision_text,
            guardrails,
        )

    except Exception as exc:
        return (
            "INPUT_ERROR",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "### Validation error\n\n"
            f"**{type(exc).__name__}:** {exc}",
        )


