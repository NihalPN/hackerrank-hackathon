CUSTOM_SYSTEM_PROMPT = """
You are the request-understanding component of a financial
affordability agent.

Extract only what the user explicitly states.

Return JSON only:

{
  "amount": "numeric amount or null",
  "currency": "ISO-like currency code or null",
  "desired_date": "YYYY-MM-DD or null",
  "request_type": "purchase|bill|transfer|debt|other",
  "allows_partial_payment": true,
  "description": "concise description",
  "facts": [
    {
      "fact_type": "amount|date|currency|description|other",
      "value": "...",
      "confidence": 0.0
    }
  ]
}

Never invent missing values.
Never calculate affordability.
Never recommend a payment method.
"""


def local_parse_request(text: str):
    currency_amount = re.search(
        r"\b("
        r"IDR|INR|ZAR|USD|EUR|GBP|AUD|CAD"
        r")\s*"
        r"([0-9][0-9,]*(?:\.[0-9]+)?)",
        text or "",
        re.IGNORECASE,
    )

    amount = None
    currency = None

    if currency_amount:
        currency = currency_amount.group(1).upper()
        amount = Decimal(
            currency_amount.group(2).replace(",", "")
        )

    iso_date = re.search(
        r"\b(20\d{2}-\d{2}-\d{2})\b",
        text or "",
    )

    desired_date = (
        iso_date.group(1)
        if iso_date
        else None
    )

    lowered = (text or "").lower()

    if any(
        x in lowered
        for x in (
            "laptop",
            "phone",
            "computer",
            "buy",
            "purchase",
        )
    ):
        request_type = "purchase"
    elif any(
        x in lowered
        for x in (
            "rent",
            "utility",
            "bill",
        )
    ):
        request_type = "bill"
    elif any(
        x in lowered
        for x in (
            "loan",
            "debt",
            "repay",
        )
    ):
        request_type = "debt"
    elif any(
        x in lowered
        for x in (
            "transfer",
            "send",
            "family",
        )
    ):
        request_type = "transfer"
    else:
        request_type = "other"

    return {
        "amount": amount,
        "currency": currency,
        "desired_date": desired_date,
        "request_type": request_type,
        "allows_partial_payment": (
            "partial" in lowered
            or "part of it" in lowered
        ),
        "description": text.strip(),
        "facts": [],
        "source": "local_fallback",
    }


def parse_custom_request(text: str):
    """
    Gemini remains the primary request-understanding agent.
    Local parsing is only the deterministic fallback.
    """

    text = safe_str(text).strip()

    if not text:
        raise ValueError(
            "Tell the agent what you want to pay."
        )

    # Gemini is the primary path.
    try:
        result = GEMINI.extract(
            prompt=(
                CUSTOM_SYSTEM_PROMPT
                + "\n\nUSER REQUEST\n"
                + text
            ),
            images=(),
        )

        raw = getattr(
            result,
            "facts",
            (),
        )

        # The current Gemini extraction client returns
        # facts rather than a separate parser object.
        extracted = {}

        for fact in raw:
            fact_type = safe_str(
                fact.get("fact_type")
            ).lower()
            value = safe_str(
                fact.get("value")
            )

            if fact_type == "amount":
                match = re.search(
                    r"([0-9][0-9,]*(?:\.[0-9]+)?)",
                    value,
                )
                if match:
                    extracted["amount"] = Decimal(
                        match.group(1).replace(",", "")
                    )

                currency = re.search(
                    r"\b(IDR|INR|ZAR|USD|EUR|GBP|AUD|CAD)\b",
                    value,
                    re.IGNORECASE,
                )

                if currency:
                    extracted["currency"] = (
                        currency.group(1).upper()
                    )

            elif fact_type == "date":
                iso = re.search(
                    r"\b20\d{2}-\d{2}-\d{2}\b",
                    value,
                )
                if iso:
                    extracted["desired_date"] = (
                        iso.group(0)
                    )

            elif fact_type == "description":
                extracted["description"] = value

        fallback = local_parse_request(text)

        extracted.setdefault(
            "currency",
            fallback["currency"],
        )
        extracted.setdefault(
            "amount",
            fallback["amount"],
        )
        extracted.setdefault(
            "desired_date",
            fallback["desired_date"],
        )
        extracted.setdefault(
            "request_type",
            fallback["request_type"],
        )
        extracted.setdefault(
            "allows_partial_payment",
            fallback["allows_partial_payment"],
        )
        extracted.setdefault(
            "description",
            text,
        )

        if extracted.get("amount") is None:
            raise ValueError(
                "Gemini could not identify a purchase amount. "
                "Please state the amount explicitly."
            )

        extracted["source"] = "gemini"
        extracted["facts"] = list(raw)

        return extracted

    except Exception as exc:
        # IMPORTANT:
        # Gemini failure does not kill the financial decision.
        fallback = local_parse_request(text)

        if fallback["amount"] is None:
            raise ValueError(
                "Gemini was unavailable and the local fallback "
                "could not identify an amount. "
                "Please include an amount such as "
                "'ZAR 37,114'."
            ) from exc

        fallback["fallback_reason"] = (
            f"Gemini unavailable: {type(exc).__name__}"
        )

        return fallback


