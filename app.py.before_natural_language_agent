def build_custom_profile(
    balance: Decimal,
    minimum_balance: Decimal,
    currency: str,
):
    """
    Build a temporary read-only profile for the custom user.

    The user supplies their own current financial state.
    """

    return FinancialProfile(
        user_id="custom_user",
        home_currency=currency,
        current_available_balance=balance,
        minimum_balance_to_keep=minimum_balance,
        financial_priorities="custom user request",
        protected_categories=(),
        reducible_categories=(),
        stoppable_categories=(),
        payment_methods_user_will_consider=(
            "full_payment",
            "partial_payment",
            "installments",
        ),
        max_installment_months=12,
    )


def build_custom_events(
    user_id: str,
    start_date: date,
    future_income,
    future_expenses,
    currency: str,
):
    events = {}

    # Optional future cash flows.
    if future_income:
        events["custom_income"] = FinancialEvent(
            event_id="custom_income",
            user_id=user_id,
            event_type="income",
            description="User-entered future income",
            category="income",
            direction=EventDirection.CREDIT,
            amount=future_income,
            currency=currency,
            event_date=start_date,
            settlement_date=start_date,
            status=EventStatus.SCHEDULED,
            linked_event_id=None,
            flexibility="fixed",
            minimum_allowed_amount=None,
        )

    if future_expenses:
        events["custom_expense"] = FinancialEvent(
            event_id="custom_expense",
            user_id=user_id,
            event_type="expense",
            description="User-entered future expense",
            category="expense",
            direction=EventDirection.DEBIT,
            amount=future_expenses,
            currency=currency,
            event_date=start_date,
            settlement_date=start_date,
            status=EventStatus.SCHEDULED,
            linked_event_id=None,
            flexibility="fixed",
            minimum_allowed_amount=None,
        )

    return events


