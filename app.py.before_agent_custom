# =========================================================
# Helpers
# =========================================================

def enum_or_str(value):
    """Works for both Enum values and plain strings."""
    return getattr(value, "value", value)


def safe_str(value) -> str:
    return "" if value is None else str(value)


def load_output_rows() -> dict[str, dict]:
    with OUTPUT_PATH.open(
        newline="",
        encoding="utf-8",
    ) as f:
        return {
            row["request_id"]: row
            for row in csv.DictReader(f)
        }


def load_evidence_cache() -> dict:
    if not CACHE_PATH.exists():
        return {}

    try:
        return json.loads(
            CACHE_PATH.read_text(
                encoding="utf-8"
            )
        )
    except Exception:
        return {}


def parse_decimal(value) -> Decimal:
    if value is None or safe_str(value).strip() == "":
        raise ValueError("Amount is required.")

    try:
        amount = Decimal(str(value))
    except (
        InvalidOperation,
        TypeError,
        ValueError,
    ) as exc:
        raise ValueError(
            "Amount must be a valid number."
        ) from exc

    if amount <= Decimal("0"):
        raise ValueError(
            "Amount must be greater than zero."
        )

    return amount


def parse_date(value) -> date:
    text = safe_str(value).strip()

    if not text:
        raise ValueError(
            "Desired completion date is required."
        )

    try:
        return date.fromisoformat(text)
    except ValueError as exc:
        raise ValueError(
            "Use the date format YYYY-MM-DD."
        ) from exc


def format_money(currency: str, amount) -> str:
    try:
        value = Decimal(str(amount))
        return f"{currency} {value:,.2f}"
    except (
        InvalidOperation,
        TypeError,
        ValueError,
    ):
        return f"{currency} {safe_str(amount)}"


def status_headline(status: str) -> str:
    mapping = {
        "affordable_now":
            "## 🟢 BUY NOW",

        "affordable_with_plan":
            "## 🟡 BUY WITH PLAN",

        "affordable_later":
            "## 🟠 WAIT",

        "not_affordable":
            "## 🔴 NOT RECOMMENDED",
    }

    return mapping.get(
        status,
        f"## {status.replace('_', ' ').upper()}",
    )


def extract_text_amounts(text: str):
    """
    Extract explicit currency+amount references from the
    user's request text. This is only used for validation/warnings.
    It never overrides the numeric Amount field.
    """
    pattern = re.compile(
        r"\b(IDR|INR|ZAR|USD|EUR|GBP|AUD|CAD)\s*"
        r"([0-9][0-9,]*(?:\.[0-9]+)?)",
        re.IGNORECASE,
    )

    values = []

    for currency, raw in pattern.findall(
        text or ""
    ):
        try:
            values.append(
                (
                    currency.upper(),
                    Decimal(
                        raw.replace(",", "")
                    ),
                )
            )
        except InvalidOperation:
            pass

    return values


