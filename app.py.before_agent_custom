# =========================================================
# Financial profile helpers
# =========================================================

def profile_events(user_id: str):
    return {
        event_id: event
        for event_id, event
        in dataset.events.items()
        if event.user_id == user_id
    }


def profile_window(
    user_id: str,
) -> tuple[date, date]:

    events = list(
        profile_events(user_id).values()
    )

    if not events:
        raise ValueError(
            "Selected profile has no financial history."
        )

    dates = [
        event.event_date
        for event in events
    ]

    dates.extend(
        event.settlement_date
        for event in events
        if event.settlement_date is not None
    )

    simulation_start = (
        max(dates) + timedelta(days=1)
    )

    simulation_end = (
        simulation_start
        + timedelta(days=90)
    )

    return (
        simulation_start,
        simulation_end,
    )


# =========================================================
# Existing benchmark request
# =========================================================

def existing_request_result(
    request_id: str,
):

    if not request_id:
        return (
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "Select a request.",
        )

    request = dataset.requests.get(
        request_id
    )

    row = output_rows.get(
        request_id
    )

    if request is None or row is None:
        return (
            request_id,
            "",
            "",
            "",
            "",
            "",
            "",
            "Request not found.",
        )

    cached = evidence_cache.get(
        request_id,
        {},
    )

    facts = cached.get(
        "facts",
        [],
    ) or []

    if facts:
        evidence = "\n".join(
            f"- {fact.get('fact_type', 'fact')}: "
            f"{fact.get('value', '')}"
            for fact in facts[:8]
        )
    elif cached.get("error"):
        evidence = (
            "⚠️ Gemini evidence was unavailable "
            "for this request. "
            "The deterministic fallback was used."
        )
    else:
        evidence = (
            "No unstructured evidence was required."
        )

    status = safe_str(
        row["affordability_status"]
    )

    decision = (
        f"{status_headline(status)}\n\n"

        f"**Safe amount:** "
        f"{row['amount_safe_to_pay']}\n\n"

        f"**Recommended method:** "
        f"{row['recommended_payment_method']}\n\n"

        f"**Payment plan:** "
        f"{row['payment_plan'] or 'None'}\n\n"

        f"**Earliest full payment:** "
        f"{row['earliest_date_for_full_payment'] or 'N/A'}\n\n"

        f"**Spending changes:** "
        f"{row['spending_changes_needed'] or 'None'}\n\n"

        f"**Explanation:** "
        f"{row['decision_explanation']}"
    )

    return (
        request_id,
        request.request_text,
        row["amount_safe_to_pay"],
        status,
        row["recommended_payment_method"],
        row["payment_plan"],
        evidence,
        decision,
    )


