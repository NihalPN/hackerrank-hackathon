# =========================================================
# Custom request decision
# =========================================================

def custom_request_result(
    user_id,
    amount,
    desired_date,
    request_text,
    request_type,
    allows_partial,
):

    try:
        # -------------------------------------------------
        # Guardrail 1: valid profile
        # -------------------------------------------------

        if user_id not in dataset.profiles:
            raise ValueError(
                "Select a valid demo financial profile."
            )

        profile = dataset.profiles[
            user_id
        ]

        # -------------------------------------------------
        # Guardrail 2: Decimal amount
        # -------------------------------------------------

        requested_amount = parse_decimal(
            amount
        )

        # -------------------------------------------------
        # Guardrail 3: 90-day window
        # -------------------------------------------------

        (
            simulation_date,
            horizon_end,
        ) = profile_window(
            user_id
        )

        completion_date = parse_date(
            desired_date
        )

        if completion_date < simulation_date:
            raise ValueError(
                "Completion date cannot be before "
                f"{simulation_date.isoformat()}."
            )

        if completion_date > horizon_end:
            raise ValueError(
                "Completion date must be between "
                f"{simulation_date.isoformat()} "
                f"and "
                f"{horizon_end.isoformat()}."
            )

        # -------------------------------------------------
        # Guardrail 4: currency/amount consistency warning
        # -------------------------------------------------

        text_amounts = extract_text_amounts(
            request_text or ""
        )

        currency_warning = ""

        if len(text_amounts) == 1:
            text_currency, text_amount = (
                text_amounts[0]
            )

            if text_currency != profile.home_currency:
                raise ValueError(
                    f"The request text specifies "
                    f"{text_currency} {text_amount:,.2f}, "
                    f"but the selected profile uses "
                    f"{profile.home_currency}. "
                    f"Please make the currency consistent."
                )

            if text_amount != requested_amount:
                raise ValueError(
                    f"The request text specifies "
                    f"{format_money(text_currency, text_amount)}, "
                    f"but the Amount field contains "
                    f"{format_money(profile.home_currency, requested_amount)}. "
                    f"Please make the two amounts match."
                )

        # -------------------------------------------------
        # Build request
        # -------------------------------------------------

        request = FinancialRequest(
            request_id=(
                "custom_gradio_request"
            ),

            user_id=user_id,

            request_date=simulation_date,

            request_type=(
                safe_str(
                    request_type
                ).strip()
                or "custom_request"
            ),

            requested_amount=requested_amount,

            desired_completion_date=(
                completion_date
            ),

            allows_partial_payment=bool(
                allows_partial
            ),

            request_text=(
                safe_str(
                    request_text
                ).strip()
                or "Custom financial request."
            ),
        )

        # -------------------------------------------------
        # Read-only user financial state
        # -------------------------------------------------

        events = profile_events(
            user_id
        )

        # -------------------------------------------------
        # No invented payment options
        #
        # The custom demo evaluates affordability from
        # the user's financial state only.
        # -------------------------------------------------

        decision = decide_v4(
            events=events,

            profile=profile,

            request=request,

            payment_options=[],

            exchange_rates=rates,
        )

        # -------------------------------------------------
        # Normalize Enum OR string
        #
        # This fixes:
        # "'str' object has no attribute 'value'"
        # -------------------------------------------------

        status = safe_str(
            enum_or_str(
                decision.affordability_status
            )
        )

        method = safe_str(
            enum_or_str(
                decision.recommended_payment_method
            )
        )

        # -------------------------------------------------
        # Payment plan
        # -------------------------------------------------

        payment_plan = "; ".join(
            f"{p.date.isoformat()}: {p.amount}"
            for p in decision.payment_plan
        )

        if not payment_plan:
            payment_plan = "None"

        # -------------------------------------------------
        # Earliest date
        # -------------------------------------------------

        earliest = (
            decision
            .earliest_date_for_full_payment
            .isoformat()
            if decision.earliest_date_for_full_payment
            else "N/A"
        )

        # -------------------------------------------------
        # Spending changes
        # -------------------------------------------------

        changes = "; ".join(
            safe_str(change)
            for change
            in decision.spending_changes_needed
            if safe_str(change)
        )

        if not changes:
            changes = "None"

        # -------------------------------------------------
        # Decision presentation
        # -------------------------------------------------

        decision_text = (
            f"{status_headline(status)}\n\n"

            f"**Profile:** "
            f"`{user_id}`\n\n"

            f"**Simulation start:** "
            f"`{simulation_date.isoformat()}`\n\n"

            f"**Requested completion:** "
            f"`{completion_date.isoformat()}`\n\n"

            f"**90-day end:** "
            f"`{horizon_end.isoformat()}`\n\n"

            f"**Home currency:** "
            f"`{profile.home_currency}`\n\n"

            f"**Amount evaluated:** "
            f"{format_money(profile.home_currency, requested_amount)}\n\n"

            f"**Safe amount:** "
            f"{format_money(profile.home_currency, decision.amount_safe_to_pay)}\n\n"

            f"**Status:** "
            f"{status}\n\n"

            f"**Recommended method:** "
            f"{method}\n\n"

            f"**Payment plan:** "
            f"{payment_plan}\n\n"

            f"**Earliest full payment:** "
            f"{earliest}\n\n"

            f"**Spending changes:** "
            f"{changes}\n\n"

            f"**Explanation:** "
            f"{(
                decision.decision_explanation
                .replace(
                    "None of the available payment options keeps "
                    "the required minimum balance protected across "
                    "the forecast.",
                    "The requested amount cannot be paid while "
                    "keeping the required minimum balance protected "
                    "across the forecast."
                )
            )}"
        )

        # -------------------------------------------------
        # Visible guardrail report
        # -------------------------------------------------

        guardrails = (
            "### Guardrails\n\n"

            f"- Simulation start: "
            f"`{simulation_date.isoformat()}`\n"

            f"- Allowed completion window: "
            f"`{simulation_date.isoformat()}` → "
            f"`{horizon_end.isoformat()}`\n"

            f"- Home currency: "
            f"`{profile.home_currency}`\n"

            "- Financial history is read-only.\n"

            "- The Amount field is authoritative.\n"

            "- Amount is converted to Decimal before "
            "financial calculations.\n"

            "- Gemini is not called from the custom "
            "demo path while the current project quota "
            "is exhausted.\n"

            "- V4 remains the financial decision authority."
        )

        if currency_warning:
            guardrails += (
                "\n\n⚠️ **Input consistency warning:** "
                + currency_warning
            )

        return (
            status,

            format_money(
                profile.home_currency,
                decision.amount_safe_to_pay,
            ),

            method,

            payment_plan,

            earliest,

            changes,

            decision_text,

            guardrails,
        )

    except Exception as exc:

        return (
            "INPUT_ERROR",
            "",
            "",
            "",
            "",
            "",
            "",

            "### Validation error\n\n"
            f"**{type(exc).__name__}:** "
            f"{exc}",
        )


