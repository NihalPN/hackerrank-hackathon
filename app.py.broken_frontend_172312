def make_custom_events(
    user_id: str,
    start_date: date,
    currency: str,
    future_income: Decimal | None,
    future_expense: Decimal | None,
):
    events = {}

    if future_income is not None:
        events["custom_income"] = FinancialEvent(
            event_id="custom_income",
            user_id=user_id,
            event_type="income",
            description="User-entered future income",
            category="income",
            direction=EventDirection.CREDIT,
            amount=future_income,
            currency=currency,
            event_date=start_date,
            settlement_date=start_date,
            status=EventStatus.SCHEDULED,
            linked_event_id=None,
            flexibility="fixed",
            minimum_allowed_amount=None,
        )

    if future_expense is not None:
        events["custom_expense"] = FinancialEvent(
            event_id="custom_expense",
            user_id=user_id,
            event_type="expense",
            description="User-entered future expense",
            category="expense",
            direction=EventDirection.DEBIT,
            amount=future_expense,
            currency=currency,
            event_date=start_date,
            settlement_date=start_date,
            status=EventStatus.SCHEDULED,
            linked_event_id=None,
            flexibility="fixed",
            minimum_allowed_amount=None,
        )

    return events


def build_payment_options(
    request_id: str,
    amount: Decimal,
    start_date: date,
    desired_date: date,
    installment_count,
    payment_frequency,
    financing_fee,
):
    options = []

    # Always permit evaluation of full payment.
    options.append(
        PaymentOption(
            payment_option_id="custom_full",
            request_id=request_id,
            payment_method=PaymentMethod.FULL_PAYMENT,
            payment_amount=amount,
            number_of_payments=1,
            first_payment_date=desired_date,
            payment_frequency_days=0,
            financing_fee=Decimal("0"),
            total_payable_amount=amount,
        )
    )

    # Only create an installment option when the user
    # explicitly provides a payment count.
    if installment_count:
        if installment_count < 2:
            raise ValueError(
                "Installment count must be at least 2."
            )

        if installment_count > 12:
            raise ValueError(
                "For this demo, installment plans are "
                "limited to 12 payments."
            )

        if payment_frequency == "weekly":
            frequency_days = 7
        else:
            # Monthly is the safe default only when the
            # user explicitly provided a count but omitted
            # frequency.
            frequency_days = 30

        total = amount

        if financing_fee is not None:
            if financing_fee < 0:
                raise ValueError(
                    "Financing fee cannot be negative."
                )
            total += financing_fee

        payment_amount = (
            total
            / Decimal(installment_count)
        )

        options.append(
            PaymentOption(
                payment_option_id="custom_installments",
                request_id=request_id,
                payment_method=PaymentMethod.INSTALLMENTS,
                payment_amount=payment_amount,
                number_of_payments=installment_count,
                first_payment_date=desired_date,
                payment_frequency_days=frequency_days,
                financing_fee=(
                    financing_fee
                    if financing_fee is not None
                    else Decimal("0")
                ),
                total_payable_amount=total,
            )
        )

    return options


