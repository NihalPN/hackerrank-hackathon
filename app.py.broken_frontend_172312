"""


CURRENCY_RE = re.compile(
    r"\b("
    r"IDR|INR|ZAR|USD|EUR|GBP|AUD|CAD"
    r")\s*"
    r"([0-9][0-9,]*(?:\.[0-9]+)?)",
    re.IGNORECASE,
)

NUMBER_RE = re.compile(
    r"\b([0-9][0-9,]*(?:\.[0-9]+)?)\b"
)


def _money_matches(text: str):
    pattern = re.compile(
        r"\b("
        r"IDR|INR|ZAR|USD|EUR|GBP|AUD|CAD"
        r")\s*"
        r"([0-9][0-9,]*(?:\.[0-9]+)?)",
        re.IGNORECASE,
    )

    results = []

    for match in pattern.finditer(text or ""):
        try:
            results.append(
                {
                    "currency": match.group(1).upper(),
                    "amount": Decimal(
                        match.group(2).replace(",", "")
                    ),
                    "start": match.start(),
                    "end": match.end(),
                    "text": match.group(0),
                }
            )
        except InvalidOperation:
            continue

    return results


def _context(text: str, start: int, end: int, window: int = 90):
    left = max(0, start - window)
    right = min(len(text), end + window)
    return text[left:right].lower()


def _classify_money_roles(text: str):
    """
    Assign semantic roles to monetary mentions.

    Priority:
    1. Explicit account balance
    2. Explicit minimum/reserve
    3. Explicit income
    4. Explicit expense
    5. Purchase/request amount
    """

    matches = _money_matches(text)

    balance = None
    minimum_balance = None
    requested_amount = None
    currency = None
    income = None
    expense = None

    for item in matches:
        amount = item.get("amount", item.get("value"))
        item_currency = item["currency"]
        context = _context(
            text,
            item["start"],
            item["end"],
        )

        if currency is None:
            currency = item_currency

        # -----------------------------
        # Account balance
        # -----------------------------
        if (
            re.search(
                r"\b("
                r"i have|"
                r"i've got|"
                r"my balance is|"
                r"account balance|"
                r"current balance|"
                r"cash balance|"
                r"available balance"
                r")\b",
                context,
            )
            and balance is None
        ):
            balance = amount
            continue

        # -----------------------------
        # Minimum protected balance
        # -----------------------------
        if (
            re.search(
                r"\b("
                r"keep|"
                r"leave|"
                r"reserve|"
                r"untouched|"
                r"minimum|"
                r"at least"
                r")\b",
                context,
            )
            and re.search(
                r"\b("
                r"keep|"
                r"leave|"
                r"reserve|"
                r"untouched|"
                r"minimum|"
                r"protected"
                r")\b",
                context,
            )
        ):
            if minimum_balance is None:
                minimum_balance = amount
                continue

        # -----------------------------
        # Future income
        # -----------------------------
        if re.search(
            r"\b("
            r"salary|"
            r"income|"
            r"receive|"
            r"get paid|"
            r"paycheck|"
            r"bonus"
            r")\b",
            context,
        ):
            if income is None:
                income = amount
                continue

        # -----------------------------
        # Future expense
        # -----------------------------
        if re.search(
            r"\b("
            r"rent|"
            r"bill|"
            r"expense|"
            r"due|"
            r"owe|"
            r"payment due"
            r")\b",
            context,
        ):
            if expense is None:
                expense = amount
                continue

    # -----------------------------
    # Requested purchase amount
    #
    # Look for explicit purchase
    # language.
    # -----------------------------
    for item in matches:
        context = _context(
            text,
            item["start"],
            item["end"],
            window=120,
        )

        if re.search(
            r"\b("
            r"buy|"
            r"purchase|"
            r"considering|"
            r"looking at|"
            r"costs?|"
            r"price|"
            r"laptop|"
            r"phone|"
            r"computer|"
            r"car|"
            r"item"
            r")\b",
            context,
        ):
            requested_amount = item.get("amount", item.get("value"))
            currency = item["currency"]
            break

    # Last-resort behavior:
    #
    # If there is exactly one money value and no
    # balance/request distinction, treat it as the request.
    if (
        requested_amount is None
        and len(matches) == 1
    ):
        requested_amount = matches[0]["amount"]
        currency = matches[0]["currency"]

    return {
        "balance": balance,
        "minimum_balance": minimum_balance,
        "amount": requested_amount,
        "currency": currency,
        "income": income,
        "expense": expense,
        "money_mentions": matches,
    }



def local_parse_request(text):
    """Deterministic fallback parser for the custom natural-language demo."""
    import re
    from decimal import Decimal, InvalidOperation

    text = (text or "").strip()

    result = {
        "facts": [],
        "parser": "local",
        "missing": [],
    }

    if not text:
        result["missing"] = [
            "current account balance",
            "minimum protected balance",
            "requested purchase amount",
            "currency",
        ]
        return result

    # ------------------------------------------------------------
    # Monetary token
    # ------------------------------------------------------------
    money = r'(?P<currency>\$|€|£|₹|[A-Za-z]{3})\s*(?P<amount>\d+(?:,\d{3})*(?:\.\d+)?)'

    symbol_currency = {
        "$": "USD",
        "€": "EUR",
        "£": "GBP",
        "₹": "INR",
    }

    def add_fact(fact_type, currency, amount, confidence=0.97, source=None):
        if amount is None:
            return

        result["facts"].append({
            "fact_type": fact_type,
            "value": str(amount),
            "currency": currency,
            "confidence": confidence,
            "source_text": source or text,
        })

    def parse_match(match):
        if not match:
            return None, None

        raw_currency = match.group("currency")
        raw_amount = match.group("amount").replace(",", "")

        try:
            amount = Decimal(raw_amount)
        except (InvalidOperation, ValueError):
            return None, None

        currency = symbol_currency.get(
            raw_currency,
            raw_currency.upper()
        )

        return currency, amount

    # ------------------------------------------------------------
    # 1. CURRENT BALANCE
    #
    # Deliberately match the amount immediately associated with
    # phrases such as "I have", "my balance", "in my account".
    # This prevents a later "keep ... untouched" amount from
    # stealing the balance role.
    # ------------------------------------------------------------
    balance_patterns = [
        rf'\b(?:I\s+have|I''ve\s+got)\s+{money}(?=\s+(?:in|on)\s+(?:my|the)\s+(?:account|bank|savings))',
        rf'\b(?:my|current|available)\s+balance\s+is\s+{money}',
        rf'\b(?:I\s+have|I''ve\s+got)\s+{money}',
        rf'{money}\s+(?:is\s+)?(?:in|on)\s+my\s+(?:account|bank|savings)',
    ]

    balance = None

    for pattern in balance_patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            currency, amount = parse_match(match)
            if amount is not None:
                balance = (currency, amount, match.group(0))
                break

    # ------------------------------------------------------------
    # 2. MINIMUM PROTECTED BALANCE
    # ------------------------------------------------------------
    minimum_patterns = [
        rf'\bkeep\s+{money}\b',
        rf'\bleave\s+{money}\b',
        rf'\breserve\s+{money}\b',
        rf'\bprotect\s+{money}\b',
        rf'\bretain\s+{money}\b',
        rf'\bminimum(?:\s+balance)?\s+(?:is\s+)?{money}\b',
        rf'\bat\s+least\s+{money}\b',
        rf'{money}\s+(?:untouched|reserved|protected)\b',
    ]

    minimum = None

    for pattern in minimum_patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            currency, amount = parse_match(match)
            if amount is not None:
                minimum = (currency, amount, match.group(0))
                break

    # ------------------------------------------------------------
    # 3. REQUEST / PURCHASE AMOUNT
    #
    # Match phrases that explicitly describe the thing being bought.
    # ------------------------------------------------------------
    request_patterns = [
        rf'\bconsidering\s+(?:a|an)?\s*{money}\b',
        rf'\b(?:buy|purchase)\s+(?:a|an)?\s*{money}\b',
        rf'\b(?:costs?|price\s+is|priced\s+at)\s+{money}\b',
        rf'\blooking\s+at\s+(?:a|an)?\s*{money}\b',
        rf'\b(?:laptop|phone|computer|car)\s*(?:costs?|is)\s*{money}\b',
        rf'\b{money}\s+(?:laptop|phone|computer|car)\b',
    ]

    requested = None

    for pattern in request_patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            currency, amount = parse_match(match)
            if amount is not None:
                requested = (currency, amount, match.group(0))
                break

    # ------------------------------------------------------------
    # 4. OTHER EXPLICIT MONEY ROLES
    # ------------------------------------------------------------
    income_patterns = [
        rf'(?:salary|income|bonus|paycheck)\s*(?:of|is)?\s*{money}',
        rf'(?:receive|get paid|getting paid)\s+{money}',
    ]

    income = None

    for pattern in income_patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            currency, amount = parse_match(match)
            if amount is not None:
                income = (currency, amount, match.group(0))
                break

    expense_patterns = [
        rf'(?:rent|bill|expense|debt|payment)\s*(?:of|is|due)?\s*{money}',
        rf'(?:owe|due)\s+{money}',
    ]

    expense = None

    for pattern in expense_patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            currency, amount = parse_match(match)
            if amount is not None:
                expense = (currency, amount, match.group(0))
                break

    fee_patterns = [
        rf'(?:fee|fees|interest|charge|financing\s+cost)\s*(?:of|is)?\s*{money}',
    ]

    fee = None

    for pattern in fee_patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            currency, amount = parse_match(match)
            if amount is not None:
                fee = (currency, amount, match.group(0))
                break

    # ------------------------------------------------------------
    # Add explicit facts
    # ------------------------------------------------------------
    if balance:
        add_fact(
            "balance",
            balance[0],
            balance[1],
            source=balance[2],
        )

    if minimum:
        add_fact(
            "minimum_balance",
            minimum[0],
            minimum[1],
            source=minimum[2],
        )

    if requested:
        add_fact(
            "amount",
            requested[0],
            requested[1],
            source=requested[2],
        )

    if income:
        add_fact(
            "income",
            income[0],
            income[1],
            source=income[2],
        )

    if expense:
        add_fact(
            "expense",
            expense[0],
            expense[1],
            source=expense[2],
        )

    if fee:
        add_fact(
            "financing_fee",
            fee[0],
            fee[1],
            source=fee[2],
        )

    # ------------------------------------------------------------
    # Currency
    # ------------------------------------------------------------
    currency_match = re.search(
        r'\b(?:USD|EUR|GBP|INR|ZAR|IDR)\b|[$€£₹]',
        text,
        re.IGNORECASE,
    )

    if currency_match:
        raw = currency_match.group(0)

        result["facts"].append({
            "fact_type": "currency",
            "value": symbol_currency.get(raw, raw.upper()),
            "currency": symbol_currency.get(raw, raw.upper()),
            "confidence": 0.99,
            "source_text": currency_match.group(0),
        })

    # ------------------------------------------------------------
    # Installment plan — ONLY when explicitly stated
    # ------------------------------------------------------------
    installment_count = None

    installment_patterns = [
        r'\b(\d+)\s+monthly\s+installments?\b',
        r'\b(\d+)\s+monthly\s+payments?\b',
        r'\b(\d+)\s+month(?:ly)?\s+installments?\b',
        r'\bpay\s+(?:it|this|that)\s+in\s+(\d+)\s+payments?\b',
        r'\b(\d+)\s+installments?\b',
    ]

    for pattern in installment_patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            installment_count = int(match.group(1))
            break

    if installment_count is not None:
        result["facts"].append({
            "fact_type": "installment_count",
            "value": str(installment_count),
            "currency": None,
            "confidence": 0.99,
            "source_text": match.group(0),
        })

        frequency = (
            "monthly"
            if re.search(r'\bmonthly\b|\bmonth\b', text, re.IGNORECASE)
            else "weekly"
            if re.search(r'\bweekly\b|\bweek\b', text, re.IGNORECASE)
            else "unknown"
        )

        result["facts"].append({
            "fact_type": "payment_frequency",
            "value": frequency,
            "currency": None,
            "confidence": 0.99,
            "source_text": match.group(0),
        })

    # ------------------------------------------------------------
    # Request type
    # ------------------------------------------------------------
    low = text.lower()

    if any(word in low for word in (
        "laptop", "phone", "computer", "car", "buy", "purchase",
        "considering",
    )):
        request_type = "purchase"
    elif any(word in low for word in ("trip", "travel", "flight", "hotel")):
        request_type = "travel"
    elif any(word in low for word in ("course", "tuition", "education")):
        request_type = "education"
    elif any(word in low for word in ("rent", "house", "deposit")):
        request_type = "housing"
    else:
        request_type = "purchase"

    result["facts"].append({
        "fact_type": "request_type",
        "value": request_type,
        "currency": None,
        "confidence": 0.90,
        "source_text": text,
    })

    # ------------------------------------------------------------

    # ------------------------------------------------------------
    # Backward-compatible fields for the existing Gradio flow.
    #
    # Older custom-request code expects:
    #   parsed["amount"]
    #   parsed["balance"]
    #   parsed["minimum_balance"]
    #   parsed["currency"]
    #   parsed["installment_count"]
    #   parsed["payment_frequency"]
    #
    # Keep those fields while retaining the structured `facts`
    # representation above.
    # ------------------------------------------------------------

    def _fact_value(kind):
        for fact in result["facts"]:
            if fact.get("fact_type") == kind:
                return fact.get("value")
        return None

    def _fact_currency(kind):
        for fact in result["facts"]:
            if fact.get("fact_type") == kind:
                return fact.get("currency")
        return None

    result["amount"] = _fact_value("amount")
    result["balance"] = _fact_value("balance")
    result["minimum_balance"] = _fact_value("minimum_balance")

    result["currency"] = (
        _fact_value("currency")
        or _fact_currency("amount")
        or _fact_currency("balance")
        or _fact_currency("minimum_balance")
    )

    result["installment_count"] = _fact_value("installment_count")
    result["payment_frequency"] = _fact_value("payment_frequency")
    result["financing_fee"] = _fact_value("financing_fee")

    result["request_type"] = _fact_value("request_type") or "purchase"

    # Missing required information
    # ------------------------------------------------------------
    if requested is None:
        result["missing"].append("requested purchase amount")

    if balance is None:
        result["missing"].append("current account balance")

    if minimum is None:
        result["missing"].append("minimum protected balance")

    if currency_match is None:
        result["missing"].append("currency")

    return result



def extract_agent_facts(text: str) -> dict:
    text = as_text(text).strip()

    if not text:
        raise ValueError(
            "Tell the agent what you want to pay "
            "and, when possible, your financial situation."
        )

    try:
        result = GEMINI.extract(
            prompt=(
                AGENT_PROMPT
                + "\n\nUSER INPUT\n"
                + text
            ),
            images=(),
        )

        facts = list(
            getattr(
                result,
                "facts",
                (),
            )
        )

        if facts:
            return {
                "facts": facts,
                "source": "gemini",
            }

    except Exception as exc:
        fallback = local_parse_request(text)
        fallback["fallback_reason"] = (
            f"Gemini unavailable: "
            f"{type(exc).__name__}"
        )
        return fallback

    fallback = local_parse_request(text)
    fallback["fallback_reason"] = (
        "Gemini returned no usable facts."
    )

    # ------------------------------------------------------------
    # Normalize Gemini output into the legacy custom-Gradio schema.
    # The downstream UI expects parsed["amount"], etc.
    # Gemini/local extraction may instead return {"facts": [...]}.
    # ------------------------------------------------------------
    if isinstance(result, dict) and "facts" in result:
        facts = result.get("facts") or []

        def _get(kind):
            for fact in facts:
                if isinstance(fact, dict):
                    if str(fact.get("fact_type", "")).lower() == kind:
                        return fact
            return None

        f_amount = _get("amount") or _get("requested_amount")
        f_balance = _get("balance") or _get("current_balance")
        f_minimum = (
            _get("minimum_balance")
            or _get("minimum_protected")
            or _get("protected_balance")
        )
        f_currency = _get("currency")
        f_installments = _get("installment_count")
        f_frequency = _get("payment_frequency")
        f_fee = _get("financing_fee") or _get("fee")
        f_type = _get("request_type")

        def _value(f):
            return f.get("value") if isinstance(f, dict) else None

        def _currency(f):
            return f.get("currency") if isinstance(f, dict) else None

        result["amount"] = _value(f_amount)
        result["balance"] = _value(f_balance)
        result["minimum_balance"] = _value(f_minimum)

        result["currency"] = (
            _value(f_currency)
            or _currency(f_amount)
            or _currency(f_balance)
            or _currency(f_minimum)
        )

        result["installment_count"] = _value(f_installments)
        result["payment_frequency"] = _value(f_frequency)
        result["financing_fee"] = _value(f_fee)
        result["request_type"] = _value(f_type) or "purchase"

    # If Gemini returns the already-normalized schema, leave it untouched.
    result.setdefault("amount", None)
    result.setdefault("balance", None)
    result.setdefault("minimum_balance", None)
    result.setdefault("currency", None)
    result.setdefault("installment_count", None)
    result.setdefault("payment_frequency", None)
    result.setdefault("financing_fee", None)
    result.setdefault("request_type", "purchase")

    return fallback



def classify_facts(facts, request_text=""):
    """
    Normalize Gemini/local facts into the custom-agent state.

    Gemini sometimes labels every monetary mention as `amount`.
    We resolve those generic amounts using the user's original
    natural-language request.
    """
    import re
    from decimal import Decimal

    # Accept both the raw facts list and the full
    # extract_agent_facts() dictionary.
    if isinstance(facts, dict):
        facts = facts.get("facts", [])

    result = {
        "balance": None,
        "minimum_balance": None,
        "requested_amount": None,
        "currency": None,
        "completion_date": None,
        "request_type": "purchase",
        "income": [],
        "expense": [],
        "installment_count": None,
        "payment_frequency": None,
        "financing_fee": None,
    }

    # ---------------------------------------------------------
    # Helpers
    # ---------------------------------------------------------
    def parse_money(value):
        """
        Extract currency + numeric amount from values such as:
        ZAR 33,114
        INR 100000
        33114
        """
        if value is None:
            return None, None

        raw = str(value).strip()

        match = re.search(
            r"(?P<currency>\$|€|£|₹|[A-Za-z]{3})?\s*"
            r"(?P<amount>\d+(?:,\d{3})*(?:\.\d+)?)",
            raw,
            re.IGNORECASE,
        )

        if not match:
            return None, None

        currency = match.group("currency")
        amount = match.group("amount").replace(",", "")

        symbols = {
            "$": "USD",
            "€": "EUR",
            "£": "GBP",
            "₹": "INR",
        }

        if currency:
            currency = symbols.get(currency, currency.upper())

        return currency, amount

    def add_unique(target, value):
        if value is not None and value not in target:
            target.append(value)

    # ---------------------------------------------------------
    # Collect Gemini facts
    # ---------------------------------------------------------
    generic_amounts = []

    for fact in facts or []:
        if not isinstance(fact, dict):
            continue

        kind = str(
            fact.get("fact_type", "")
        ).strip().lower()

        value = fact.get("value")

        if value in (None, "", "null"):
            continue

        if kind == "amount":
            currency, amount = parse_money(value)
            if amount is not None:
                generic_amounts.append({
                    "raw": value,
                    "currency": currency,
                    "amount": amount,
                })

        elif kind in {
            "balance",
            "current_balance",
            "account_balance",
        }:
            currency, amount = parse_money(value)
            if amount is not None:
                result["balance"] = amount
                result["currency"] = (
                    result["currency"] or currency
                )

        elif kind in {
            "minimum_balance",
            "minimum_protected",
            "minimum_protected_balance",
            "protected_balance",
        }:
            currency, amount = parse_money(value)
            if amount is not None:
                result["minimum_balance"] = amount
                result["currency"] = (
                    result["currency"] or currency
                )

        elif kind in {
            "requested_amount",
            "purchase_amount",
            "request_amount",
        }:
            currency, amount = parse_money(value)
            if amount is not None:
                result["requested_amount"] = amount
                result["currency"] = (
                    result["currency"] or currency
                )

        elif kind == "currency":
            result["currency"] = str(value).upper()

        elif kind in {
            "date",
            "completion_date",
            "desired_completion_date",
        }:
            result["completion_date"] = str(value)

        elif kind == "request_type":
            result["request_type"] = str(value)

        elif kind == "income":
            add_unique(result["income"], value)

        elif kind == "expense":
            add_unique(result["expense"], value)

        elif kind in {
            "installment_count",
            "number_of_payments",
        }:
            try:
                result["installment_count"] = int(value)
            except (TypeError, ValueError):
                pass

        elif kind in {
            "payment_frequency",
            "frequency",
        }:
            result["payment_frequency"] = str(value).lower()

        elif kind in {
            "financing_fee",
            "fee",
        }:
            currency, amount = parse_money(value)
            if amount is not None:
                result["financing_fee"] = amount
                result["currency"] = (
                    result["currency"] or currency
                )

    # ---------------------------------------------------------
    # Resolve generic Gemini "amount" facts semantically.
    # ---------------------------------------------------------
    text = request_text or ""
    lower = text.lower()

    def money_after(patterns):
        """
        Return the first monetary value directly associated with
        one of the supplied linguistic patterns.
        """
        money = (
            r"(?P<currency>\$|€|£|₹|[A-Za-z]{3})\s*"
            r"(?P<amount>\d+(?:,\d{3})*(?:\.\d+)?)"
        )

        for prefix in patterns:
            match = re.search(
                prefix + r"\s*" + money,
                text,
                re.IGNORECASE,
            )

            if match:
                currency = match.group("currency")
                amount = match.group("amount").replace(",", "")

                symbols = {
                    "$": "USD",
                    "€": "EUR",
                    "£": "GBP",
                    "₹": "INR",
                }

                currency = (
                    symbols.get(currency, currency.upper())
                    if currency else None
                )

                return amount, currency

        return None, None

    # Current account balance.
    balance_amount, balance_currency = money_after([
        r"\bi\s+have\s+",
        r"\bi['’]ve\s+got\s+",
        r"\bmy\s+balance\s+is\s+",
        r"\bcurrent\s+balance\s+is\s+",
        r"\bavailable\s+balance\s+is\s+",
        r"\baccount\s+balance\s+is\s+",
    ])

    if balance_amount is not None:
        result["balance"] = balance_amount
        result["currency"] = (
            result["currency"] or balance_currency
        )

    # Minimum protected balance.
    minimum_amount, minimum_currency = money_after([
        r"\bkeep\s+",
        r"\bleave\s+",
        r"\breserve\s+",
        r"\bprotect\s+",
        r"\bretain\s+",
        r"\bat\s+least\s+",
    ])

    if minimum_amount is not None:
        result["minimum_balance"] = minimum_amount
        result["currency"] = (
            result["currency"] or minimum_currency
        )

    # Requested purchase amount.
    requested_amount, requested_currency = money_after([
        r"\bconsidering\s+(?:a|an)?\s*",
        r"\blooking\s+at\s+(?:a|an)?\s*",
        r"\blooking\s+to\s+buy\s+(?:a|an)?\s*",
    ])

    if requested_amount is None:
        # "laptop costs ZAR 33,114"
        match = re.search(
            r"\b(?:laptop|phone|computer|car|item)\s+"
            r"(?:costs?|is\s+priced\s+at)\s+"
            r"(?P<currency>\$|€|£|₹|[A-Za-z]{3})?\s*"
            r"(?P<amount>\d+(?:,\d{3})*(?:\.\d+)?)",
            text,
            re.IGNORECASE,
        )

        if match:
            requested_amount = match.group("amount").replace(",", "")
            requested_currency = match.group("currency")

            symbols = {
                "$": "USD",
                "€": "EUR",
                "£": "GBP",
                "₹": "INR",
            }

            if requested_currency:
                requested_currency = symbols.get(
                    requested_currency,
                    requested_currency.upper(),
                )

    if requested_amount is not None:
        result["requested_amount"] = requested_amount
        result["currency"] = (
            result["currency"] or requested_currency
        )

    # ---------------------------------------------------------
    # If the request text did not provide semantic clues,
    # preserve generic Gemini amounts in a safe deterministic
    # order rather than crashing.
    #
    # This is only a fallback. It is NOT used for the example
    # above because the semantic rules resolve it first.
    # ---------------------------------------------------------
    used = {
        str(result["balance"]) if result["balance"] is not None else None,
        str(result["minimum_balance"])
        if result["minimum_balance"] is not None
        else None,
        str(result["requested_amount"])
        if result["requested_amount"] is not None
        else None,
    }

    unused = [
        item for item in generic_amounts
        if str(item["amount"]) not in used
    ]

    if result["balance"] is None and unused:
        item = unused.pop(0)
        result["balance"] = item["amount"]
        result["currency"] = (
            result["currency"] or item["currency"]
        )

    if result["minimum_balance"] is None and unused:
        item = unused.pop(0)
        result["minimum_balance"] = item["amount"]
        result["currency"] = (
            result["currency"] or item["currency"]
        )

    if result["requested_amount"] is None and unused:
        item = unused[-1]
        result["requested_amount"] = item["amount"]
        result["currency"] = (
            result["currency"] or item["currency"]
        )

    # Backward-compatible aliases used by the existing Gradio flow.
    result["amount"] = result["requested_amount"]

# =========================================================
    # FINAL TYPE NORMALIZATION
    #
    # Everything below this point is the contract consumed by
    # the existing Gradio + deterministic financial engine.
    #
    # Monetary values -> Decimal
    # Dates            -> date
    # Counts           -> int
    # =========================================================

    from datetime import date as _date
    from datetime import datetime as _datetime
    from decimal import Decimal as _Decimal
    import re as _re

    def _to_decimal(value):
        if value is None:
            return None

        if isinstance(value, _Decimal):
            return value

        if isinstance(value, (int, float)):
            return _Decimal(str(value))

        raw = str(value).strip()

        if not raw:
            return None

        # Remove currency codes/symbols and thousands separators.
        raw = _re.sub(
            r"[^0-9.\-]",
            "",
            raw.replace(",", ""),
        )

        if not raw:
            return None

        try:
            return _Decimal(raw)
        except Exception:
            return None

    def _to_date(value):
        if value is None:
            return None

        if isinstance(value, _date):
            return value

        if isinstance(value, _datetime):
            return value.date()

        raw = str(value).strip()

        if not raw:
            return None

        # ISO date.
        try:
            return _date.fromisoformat(raw)
        except ValueError:
            pass

        # Common alternatives, only where explicitly provided.
        for fmt in (
            "%d/%m/%Y",
            "%m/%d/%Y",
            "%d-%m-%Y",
            "%m-%d-%Y",
        ):
            try:
                return _datetime.strptime(raw, fmt).date()
            except ValueError:
                continue

        return None

    def _to_int(value):
        if value is None:
            return None

        if isinstance(value, int):
            return value

        try:
            return int(str(value).strip())
        except (TypeError, ValueError):
            return None

    # Monetary values.
    result["balance"] = _to_decimal(
        result.get("balance")
    )

    result["minimum_balance"] = _to_decimal(
        result.get("minimum_balance")
    )

    result["requested_amount"] = _to_decimal(
        result.get("requested_amount")
    )

    result["amount"] = result["requested_amount"]

    result["financing_fee"] = _to_decimal(
        result.get("financing_fee")
    )

    # Date.
    result["completion_date"] = _to_date(
        result.get("completion_date")
    )

    # Existing Gradio flow expects desired_date.
    result["desired_date"] = (
        result["completion_date"]
        or _date.today()
    )

    # Payment-plan count.
    result["installment_count"] = _to_int(
        result.get("installment_count")
    )

    # Normalize payment frequency.
    if result.get("payment_frequency"):
        result["payment_frequency"] = str(
            result["payment_frequency"]
        ).strip().lower()

    # Currency.
    if result.get("currency"):
        result["currency"] = str(
            result["currency"]
        ).strip().upper()

    # Normalize known income/expense values where possible.
    result["income"] = [
        value
        for value in (
            _to_decimal(x)
            for x in result.get("income", [])
        )
        if value is not None
    ]

    result["expense"] = [
        value
        for value in (
            _to_decimal(x)
            for x in result.get("expense", [])
        )
        if value is not None
    ]




    # ---------------------------------------------------------
    # Explicit payment-plan extraction from the original user
    # request. Gemini may label "3 monthly installments" as
    # `other`, so the financial flow must not depend on Gemini
    # getting this semantic label exactly right.
    # ---------------------------------------------------------
    if request_text:
        import re

        plan_patterns = [
            r'\b(\d+)\s+monthly\s+installments?\b',
            r'\b(\d+)\s+monthly\s+payments?\b',
            r'\b(\d+)\s+month(?:ly)?\s+installments?\b',
            r'\bpay\s+(?:it|this|that)\s+in\s+(\d+)\s+payments?\b',
            r'\b(\d+)\s+installments?\b',
        ]

        for pattern in plan_patterns:
            match = re.search(
                pattern,
                request_text,
                re.IGNORECASE,
            )

            if match:
                result["installment_count"] = int(match.group(1))

                if re.search(
                    r'\bmonthly\b|\bmonth\b',
                    match.group(0),
                    re.IGNORECASE,
                ):
                    result["payment_frequency"] = "monthly"
                elif re.search(
                    r'\bweekly\b|\bweek\b',
                    match.group(0),
                    re.IGNORECASE,
                ):
                    result["payment_frequency"] = "weekly"
                elif re.search(
                    r'\bdaily\b|\bday\b',
                    match.group(0),
                    re.IGNORECASE,
                ):
                    result["payment_frequency"] = "daily"

                break

    return result


